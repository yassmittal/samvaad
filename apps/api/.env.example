# Meta Model API key (https://dev.meta.ai). Server-side only: it never reaches the browser.
META_API_KEY=

# Port the API listens on.
PORT=4400

# Comma-separated origins allowed to call the API and open its WebSocket.
# Add your Cloudflare tunnel URL here when testing on a phone.
ALLOWED_WEB_ORIGINS=http://localhost:3400

# Muse Voice Transcribe realtime endpoint. Only tests change this.
# META_TRANSCRIPTION_URL=wss://api.meta.ai/v1/asr/realtime

# Muse Spark Chat Completions endpoint and model for translation (D-006).
# META_CHAT_COMPLETIONS_URL=https://api.meta.ai/v1/chat/completions
# META_TRANSLATION_MODEL_ID=muse-spark-1.3
