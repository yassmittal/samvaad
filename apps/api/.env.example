# Meta Model API key (https://dev.meta.ai). Server-side only: it never reaches the browser.
META_API_KEY=

# Port the API listens on.
PORT=4400

# Comma-separated origins allowed to call the API and open its WebSocket.
# Add your Cloudflare tunnel URL here when testing on a phone.
ALLOWED_WEB_ORIGINS=http://localhost:3400

# A room's microphones close after this many minutes, so a forgotten open mic can't drain the
# credit (D-017).
# MAX_ROOM_DURATION_MINUTES=60

# How long a room keeps the seat of a phone whose connection dropped (D-017).
# PARTICIPANT_RECONNECT_GRACE_SECONDS=60

# Muse Voice Transcribe realtime endpoint. Only tests change this.
# META_TRANSCRIPTION_URL=wss://api.meta.ai/v1/asr/realtime

# Muse Spark Chat Completions endpoint and model for translation (D-006).
# META_CHAT_COMPLETIONS_URL=https://api.meta.ai/v1/chat/completions
# META_TRANSLATION_MODEL_ID=muse-spark-1.3

# Identical translation requests raced against each other; the first to answer wins (D-020).
# 1 turns the race off.
# TRANSLATION_PARALLEL_REQUEST_COUNT=2

# Who speaks the translation (D-021): `browser` (each phone's own voice, the default),
# `elevenlabs` or `cartesia` (a natural voice streamed through the API). A voice API needs its
# key and at least one voice id; `bun run compare:voices --list` lists them. The room's first
# participant is spoken in the first voice, the second in the second.
# SPEECH_PROVIDER=browser
# SPEECH_VOICE_IDS=
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# CARTESIA_API_KEY=
# CARTESIA_MODEL_ID=sonic-3

# Optional Cloudflare TURN key for the real voice between the phones (D-023). Without it, phones
# find each other through free STUN only; some mobile networks block that, and the call then
# works without the real voice. Cloudflare dashboard → Realtime → TURN: create a key, then put
# its id and API token here. 1,000 GB a month are free.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
